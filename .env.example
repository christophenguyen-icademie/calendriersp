# Configuration locale de Docker Compose. Copier vers .env pour la personnaliser.
BIND_ADDRESS=127.0.0.1
DATABASE_PORT=5432
BACKEND_PORT=8000
WEB_PORT=8080
# Adresse d’écoute du frontal pour un téléphone sur le réseau local.
# Décommenter si nécessaire ; utiliser l’IP du poste dans l’API configurée dans MobileSP.
# WEB_BIND_ADDRESS=0.0.0.0
# Origines exactes autorisées pour Expo web (même hôte que l’API pour les cookies).
# Si Expo démarre sur 8083, ajouter http://localhost:8083 et http://127.0.0.1:8083.
MOBILE_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Production mobilesp10.fr : remplacer la ligne precedente dans le .env du VPS.
# MOBILE_WEB_ORIGINS=https://mobilesp10.fr,https://www.mobilesp10.fr,https://amicale-calendriers.mobilesp10.fr,https://api-calendriers.mobilesp10.fr
# Apres modification : docker compose up -d --force-recreate --wait backend
POSTGRES_DB=calendriersp
POSTGRES_USER=calendriersp
POSTGRES_PASSWORD=calendriersp_dev
APP_SECRET=calendriersp_local_dev_change_me
# Sources cartographiques (services publics, ou instances propres).
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOCODER_URL=https://data.geopf.fr/geocodage/search
BAN_URL=https://adresse.data.gouv.fr/data/ban/adresses/latest/csv
BAN_DEPARTMENTS_URL=https://contours-administratifs.s3.rbx.io.cloud.ovh.net/latest/geojson/departements-100m.geojson
